CREATE TABLE PART_CODE_MAPPING (
  mapping_id          INT PRIMARY KEY AUTO_INCREMENT,
  program_code        VARCHAR(10) NOT NULL,
  participation_status VARCHAR(20) NOT NULL,
  part_code           VARCHAR(2) NOT NULL,
  lob_code            VARCHAR(2),
  code_modifier       VARCHAR(2),
  can_override_to     VARCHAR(2),
  effective_date      DATE NOT NULL,
  end_date            DATE,
  is_active           BOOLEAN DEFAULT TRUE,
  created_by          VARCHAR(100),
  created_date        TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
  modified_by         VARCHAR(100),
  modified_date       TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
 
  UNIQUE KEY unique_mapping (program_code, participation_status, effective_date),
  INDEX idx_program (program_code),
  INDEX idx_status (participation_status),
  INDEX idx_active (is_active)
);
 
